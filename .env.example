# ──────────────────────────────────────────────────────────────
# Content Dashboard — environment variables
# Copy this file to .env.local and fill in the values you have.
# Everything except Supabase is optional — features whose keys are
# missing simply stay dormant (they won't crash the app).
# ──────────────────────────────────────────────────────────────

# ─── Branding (these make the dashboard "yours") ───────────────
# Shown in the browser tab, login screen, sidebar logo alt text.
NEXT_PUBLIC_BRAND_NAME="My Content Dashboard"
# First name for the "Good morning, ___" greeting.
NEXT_PUBLIC_OWNER_NAME="Alex"
# Your public app URL, no trailing slash. Used for OAuth redirects.
NEXT_PUBLIC_APP_URL="https://your-dashboard.vercel.app"
# Timezone for the content calendar (IANA name). Defaults to America/New_York.
DASHBOARD_TIMEZONE="America/New_York"

# ─── Creator profile (steers the AI: scripts, captions, ideas) ──
# Describe who the AI is writing for so generated content sounds like you.
CREATOR_NAME="Alex Rivera"
CREATOR_HANDLE="alexrivera"            # no @ — used as @handle in captions
CREATOR_NICHE="teaches small business owners how to grow on social media"
CREATOR_AUDIENCE="creators and founders who want more reach without burning out"
CREATOR_VOICE="Direct, energetic, no fluff. Real talk with genuine care."

# ─── Supabase (REQUIRED — database + auth) ─────────────────────
# Create a project at supabase.com, then run supabase/migrations/*.sql.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-only, keep secret

# ─── Instagram Graph API (your own post metrics) ───────────────
# A long-lived token + IG user/business account ID from a connected
# Instagram Business/Creator account.
IG_ACCESS_TOKEN="your-ig-graph-token"
IG_USER_ID="your-ig-user-id"
IG_BUSINESS_ACCOUNT_ID="your-ig-business-account-id"

# ─── Meta / Facebook (optional — ads + extra graph calls) ──────
META_ACCESS_TOKEN=""
FB_ACCESS_TOKEN=""

# ─── AI providers ──────────────────────────────────────────────
# Anthropic powers scripts, captions, ideas, trending brief, email triage.
ANTHROPIC_API_KEY="sk-ant-..."
# OpenAI is used for Whisper transcription of your videos. Optional.
OPENAI_API_KEY=""
# Gemini is an optional alternate transcription/vision provider. Optional.
GEMINI_API_KEY=""

# ─── Apify (competitor scraping) ───────────────────────────────
# Used by the competitor-refresh jobs to pull competitor IG posts.
APIFY_API_TOKEN=""

# ─── Zernio (multi-platform scheduling) ────────────────────────
# Get your API key + per-platform account IDs from your Zernio account.
# Leave any platform blank to skip it.
ZERNIO_API_KEY=""
ZERNIO_ACCOUNT_INSTAGRAM=""
ZERNIO_ACCOUNT_TIKTOK=""
ZERNIO_ACCOUNT_YOUTUBE=""
ZERNIO_ACCOUNT_FACEBOOK=""
# Set to "true" only if you've purchased Zernio's analytics add-on.
ZERNIO_ANALYTICS_ENABLED="false"

# ─── Stripe (optional — revenue widgets on the financials page) ─
STRIPE_SECRET_KEY=""

# ─── Google (publishing queue reads videos from a Drive folder) ────
# This is OPTIONAL. It only powers the "pull ready-to-post videos from Drive"
# workflow (and, if you grant the scopes, the optional Calendar + Gmail-triage
# features). Skip the whole block if you don't use Drive.
#
# All of it runs on ONE Google OAuth app (client ID + secret + refresh token).
# Create an OAuth app in Google Cloud, enable the Drive API, grant the Drive
# scope, and generate a refresh token. Redirect URI for the consent flow is:
#   <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GMAIL_CLIENT_ID=""        # despite the name, this is your Google OAuth client ID
GMAIL_CLIENT_SECRET=""    # your Google OAuth client secret
GMAIL_REFRESH_TOKEN=""    # refresh token with Drive (+ optional Calendar/Gmail) scope
# The Drive folder the publishing queue pulls "ready to post" videos from.
GOOGLE_DRIVE_FOLDER_ID=""
# Only import Drive files created on/after this ISO date. Blank = import all.
GOOGLE_DRIVE_CUTOFF_DATE=""

# ─── X / Twitter (optional — trending topics brief) ────────────
X_BEARER_TOKEN=""

# ─── Secrets that protect your cron + worker endpoints ─────────
# Generate random strings (e.g. `openssl rand -hex 32`). The same CRON_SECRET
# must be sent as a Bearer token by Vercel Cron / your trigger script.
CRON_SECRET=""
WORKER_SECRET=""
TRENDING_INGEST_SECRET=""

# ─── Optional integrations ─────────────────────────────────────
# An n8n webhook the app can ping for custom automations. Optional.
N8N_WEBHOOK_URL=""
# Path to an ffmpeg binary if the bundled ffmpeg-static isn't found. Optional.
FFMPEG_BIN=""
